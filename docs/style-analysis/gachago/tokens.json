{
  "$description": "Design tokens learned from https://www.gachago.net/ (observed 2026-10-17). For style study only; values are generic CSS properties, not brand assets. Each group has a $source: verified-css = value read from the site's public CSS, verified-pixel = sampled from REA screenshots, inferred = our recommendation derived from those values.",
  "color": {
    "$source": "verified-css (custom properties --color-ga-*, arbitrary Tailwind values) and verified-pixel (screenshot sampling)",
    "brand": {
      "coffee-600": {
        "$value": "#725349",
        "$note": "Primary text, card borders, active pill"
      },
      "coffee-700": {
        "$value": "#5e443b",
        "$note": "Hover for brand-colored elements"
      },
      "coffee-500-alt": {
        "$value": "#6f534a",
        "$note": "Near-duplicate coffee used in some utilities"
      },
      "red-400": {
        "$value": "#e05a47",
        "$note": "Primary/accent (PRO button, mascot)"
      },
      "red-hover": { "$value": "#d65d4b" },
      "yellow-200": { "$value": "#f2c94c" },
      "orange-300": { "$value": "#f6b340" },
      "green-300": { "$value": "#5fb376" },
      "blue-400": { "$value": "#4d9bea" }
    },
    "surface": {
      "cream-50": {
        "$value": "#f5f0e8",
        "$note": "Page background (pixel-verified)"
      },
      "cream-alt": {
        "$value": "#f6f3eb",
        "$note": "Tool/game container background"
      },
      "paper": { "$value": "#fffdf5" },
      "card": { "$value": "#ffffff" },
      "card-media": {
        "$value": "#f3e1b0",
        "$note": "Card illustration panel (pixel-verified)"
      },
      "pill": { "$value": "#ebe2d1", "$note": "Inactive filter pill" },
      "pill-hover": { "$value": "#dfd4c3" },
      "divider-dots": { "$value": "#e1d4c2" },
      "muted-text": { "$value": "#9a867b" },
      "ink-dark": { "$value": "#312522" }
    },
    "social": {
      "discord": { "$value": "#5c67e8" },
      "discord-hover": { "$value": "#4a54c1" },
      "x": { "$value": "#333333" },
      "x-hover": { "$value": "#1a1a1a" }
    },
    "alpha": {
      "brand-60": {
        "$value": "#72534999",
        "$note": "Footer chips; renders as #a69289 on cream (pixel-verified)"
      },
      "brand-80": { "$value": "#725349cc", "$note": "Secondary body text" },
      "shadow-brand": {
        "$value": "#72534935",
        "$note": "Card hard drop shadow"
      }
    }
  },
  "font": {
    "$source": "verified-css (* selector, --font-bungee) and verified-network (Google Fonts requests)",
    "family": {
      "base": {
        "$value": "\"Chiron GoRound TC\", sans-serif",
        "$note": "Applied to every element via the * selector"
      },
      "display-latin": {
        "$value": "\"Bungee\", sans-serif",
        "$note": "Utility .!font-bungee; usage location not verified"
      }
    },
    "weight": {
      "base": {
        "$value": 900,
        "$note": "Global default on * — the whole UI uses the heaviest weight"
      },
      "bold": { "$value": 700 },
      "medium": { "$value": 500 }
    },
    "size": {
      "$note": "Tailwind v4 scale (rem). Observed usage: card title lg→xl, card body sm, tagline xl→2xl, pills sm→base",
      "xs": { "$value": "0.75rem", "lineHeight": "1rem" },
      "sm": { "$value": "0.875rem", "lineHeight": "1.25rem" },
      "base": { "$value": "1rem", "lineHeight": "1.5rem" },
      "lg": { "$value": "1.125rem", "lineHeight": "1.75rem" },
      "xl": { "$value": "1.25rem", "lineHeight": "1.75rem" },
      "2xl": { "$value": "1.5rem", "lineHeight": "2rem" },
      "heading-fluid": { "$value": "clamp(32px, 5vw, 36px)" }
    }
  },
  "space": {
    "$source": "verified-css (--spacing: .25rem) and verified-html (class names)",
    "unit": { "$value": "0.25rem" },
    "grid-gap-mobile": { "$value": "0.75rem" },
    "grid-gap-desktop": { "$value": "1rem" },
    "page-gutter": { "$value": "1rem" },
    "content-max-width": { "$value": "1250px" },
    "intro-max-width": { "$value": "800px" }
  },
  "breakpoint": {
    "$source": "verified-css (@media rules)",
    "sm": { "$value": "40rem" },
    "md": { "$value": "48rem" },
    "cards-row": {
      "$value": "800px",
      "$note": "Card switches from vertical tile to horizontal row"
    },
    "lg": { "$value": "64rem" },
    "cards-3col": { "$value": "1180px" }
  },
  "radius": {
    "$source": "verified-html",
    "card": { "$value": "20px" },
    "pill": { "$value": "9999px" },
    "logo": { "$value": "50%" }
  },
  "border": {
    "$source": "verified-html",
    "card": { "$value": "7px solid #725349" },
    "logo": { "$value": "8px solid #725349" },
    "divider": { "$value": "7px dotted #e1d4c2" }
  },
  "shadow": {
    "$source": "verified-html",
    "card-rest": {
      "$value": "0 4px 0 #72534935",
      "$note": "Hard, unblurred 'sticker' shadow"
    },
    "card-hover": {
      "$value": "0 0 0 #72534950",
      "$note": "Combined with translateY(4px): card 'presses down'"
    }
  },
  "motion": {
    "$source": "verified-css",
    "duration-fast": {
      "$value": "150ms",
      "$note": "Tailwind default transition (pills: transition-colors)"
    },
    "duration-card": { "$value": "300ms" },
    "duration-enter": { "$value": "400ms" },
    "easing-default": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "easing-enter": { "$value": "ease-out" },
    "enter-offset": {
      "$value": "20px",
      "$note": "Rise-and-fade on page sections; disabled under prefers-reduced-motion"
    }
  }
}
